{
  "name": "mugxie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file=.env server/index.js",
    "start": "node --env-file=.env server/index.js",
    "test": "wrangler deploy --dry-run --outdir .wrangler/build && node --test server/*.test.js cloudflare/*.test.js",
    "cf:dev": "npm run build && wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply mugxie-catalogo --local",
    "cf:migrate": "wrangler d1 migrations apply mugxie-catalogo --remote",
    "cf:deploy": "node scripts/deploy-cloudflare.js",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:seed": "node scripts/seed-cloudflare.js",
    "cf:local:setup": "node scripts/local-cloudflare.js && wrangler d1 migrations apply mugxie-catalogo --local",
    "cf:setup": "node scripts/setup-cloudflare.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  }
}
